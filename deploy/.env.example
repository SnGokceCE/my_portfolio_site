# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env dosyasını ASLA git'e ekleme.

# Alan adı (DNS'te A kaydı sunucunun IP'sini göstermeli)
DOMAIN=ornek.dev

# CI'ın yayımladığı imaj
IMAGE=ghcr.io/KULLANICI/DEPO:latest

# Veritabanı parolası — uzun ve rastgele olsun: openssl rand -base64 32
POSTGRES_PASSWORD=

# İlk açılışta oluşturulacak admin hesabı (giriş yaptıktan sonra bu satırları silebilirsin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Ziyaretçi istatistikleri için gizli anahtar: openssl rand -hex 32
ANALYTICS_SECRET=

# SMTP (iletişim formu bildirimi). Boş bırakılırsa e-posta gönderilmez, yalnızca loglanır.
# Örnek: Brevo, Mailgun, Gmail uygulama şifresi, kurumsal posta sunucusu
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# İsteğe bağlı: GitHub API sınırını 60'tan 5000 isteğe/saat çıkarır (yetkisiz, salt-okunur jeton yeterli)
GITHUB_TOKEN=
