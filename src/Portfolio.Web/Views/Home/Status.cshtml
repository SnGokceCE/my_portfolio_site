@model StatusViewModel
@{
    ViewData["Title"] = L[Model.Title].Value;
}

<section class="section status-page">
    <div class="container narrow center">
        <p class="status-code gradient-text">@Model.Code</p>
        <h1>@L[Model.Title]</h1>
        <p class="muted">@L[Model.Message]</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">@L["Ana sayfaya dön"]</a>
    </div>
</section>
