@model HomeViewModel
@{
    var profile = Model.Profile;
    ViewData["Description"] = profile.Headline;
    var today = DateOnly.FromDateTime(DateTime.Today);
    // Gruplar, içlerindeki en küçük sıra numarasına göre dizilir; panelde verilen sıra sitede de korunur.
    var skillGroups = Model.Skills.GroupBy(s => s.Group ?? L["Diğer"].Value).OrderBy(g => g.Min(s => s.SortOrder)).ToList();
    var english = SiteCultures.IsEnglish(Context.Request);
    var topSkills = Model.Skills.OrderByDescending(s => s.Level).ThenBy(s => s.SortOrder).Take(3).Select(s => s.Name).ToList();
    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
}

@section Head {
    @JsonLd.Script(JsonLd.Person(profile, origin), JsonLd.WebSite(profile, origin, english ? "en" : "tr"))
}

<section class="hero" id="hakkimda">
    <div class="hero-bg" aria-hidden="true">
        <div class="blob blob-a"></div>
        <div class="blob blob-b"></div>
        <div class="grid-overlay"></div>
    </div>

    <div class="container hero-inner">
        <div class="hero-copy">
            @if (profile.IsOpenToWork)
            {
                <span class="badge badge-live reveal"><span class="pulse" aria-hidden="true"></span>@L["Yeni fırsatlara açığım"]</span>
            }

            <h1 class="hero-title reveal">
                @L["Merhaba, ben"] <span class="gradient-text">@profile.FullName</span>.
            </h1>
            <p class="hero-headline reveal">@profile.Headline</p>

            @if (!string.IsNullOrWhiteSpace(profile.Bio))
            {
                <p class="hero-bio reveal">@profile.Bio</p>
            }

            <div class="hero-actions reveal">
                <a class="btn btn-primary" asp-controller="Projects" asp-action="Index">@L["Projelerime göz at"]</a>
                <a class="btn btn-ghost" asp-controller="Contact" asp-action="Index">@L["İletişime geç"]</a>
            </div>

            @if (profile.Location is not null)
            {
                <p class="hero-meta muted reveal">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></svg>
                    @profile.Location
                </p>
            }
        </div>

        <div class="hero-card reveal" aria-hidden="true">
            <div class="terminal">
                <div class="terminal-bar">
                    <span></span><span></span><span></span>
                    <code>profile.json</code>
                </div>
                <pre class="terminal-body"><code><span class="t-p">{</span>
  <span class="t-k">@(english ? "\"name\"" : "\"ad\"")</span>: <span class="t-s">"@profile.FullName"</span>,
  <span class="t-k">@(english ? "\"strengths\"" : "\"guclu_yonler\"")</span>: [@Html.Raw(string.Join(", ", (topSkills.Count > 0 ? topSkills : [L["öğrenmek"].Value]).Select(s => $"<span class=\"t-s\">\"{System.Net.WebUtility.HtmlEncode(s)}\"</span>")))],
  <span class="t-k">@(english ? "\"featured_projects\"" : "\"secili_proje\"")</span>: <span class="t-n">@Model.FeaturedProjects.Count</span>,
  <span class="t-k">@(english ? "\"available\"" : "\"musait\"")</span>: <span class="t-b">@(profile.IsOpenToWork ? "true" : "false")</span>
<span class="t-p">}</span><span class="caret"></span></code></pre>
            </div>
        </div>
    </div>
</section>

<section class="section" id="projeler">
    <div class="container">
        <header class="section-head section-head-row reveal">
            <div>
                <p class="eyebrow">@L["Seçilmiş çalışmalar"]</p>
                <h2>@L["Projeler"]</h2>
                <p class="muted">@L["Üzerinde çalıştığım, öğrendiğim ve gurur duyduğum işler."]</p>
            </div>
            @if (Model.FeaturedProjects.Count > 0)
            {
                <a class="btn btn-ghost" asp-controller="Projects" asp-action="Index">@L["Tüm projeler →"]</a>
            }
        </header>

        @if (Model.FeaturedProjects.Count == 0)
        {
            <div class="empty-state reveal">
                <div class="empty-icon" aria-hidden="true">
                    <svg class="icon" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
                </div>
                <h3>@L["Projeler yolda"]</h3>
                <p class="muted">@L["Yakında burada çalışmalarımı paylaşacağım."]</p>
            </div>
        }
        else
        {
            <div class="project-grid">
                @foreach (var project in Model.FeaturedProjects)
                {
                    <partial name="_ProjectCard" model="project" />
                }
            </div>
        }
    </div>
</section>

<section class="section section-alt" id="deneyim">
    <div class="container">
        <header class="section-head reveal">
            <p class="eyebrow">@L["Yolculuk"]</p>
            <h2>@L["Deneyim"]</h2>
            <p class="muted">@L["Eğitim, staj ve iş deneyimlerim."]</p>
        </header>

        @if (Model.Experiences.Count == 0)
        {
            <div class="empty-state reveal">
                <div class="empty-icon" aria-hidden="true">
                    <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                </div>
                <h3>@L["Zaman çizelgesi yolda"]</h3>
                <p class="muted">@L["Deneyimler eklendiğinde burada görünecek."]</p>
            </div>
        }
        else
        {
            <ol class="timeline">
                @foreach (var e in Model.Experiences)
                {
                    <li class="timeline-entry reveal @(e.EndDate is null ? "is-current" : "")">
                        <span class="timeline-marker" aria-hidden="true"></span>
                        <div class="timeline-when">
                            <span>@DisplayText.Period(e.StartDate, e.EndDate)</span>
                            <span class="muted small">@DisplayText.Duration(e.StartDate, e.EndDate, today)</span>
                        </div>
                        <div class="timeline-card card">
                            <div class="timeline-head">
                                <span class="type-badge type-@e.Type.ToString().ToLowerInvariant()">@DisplayText.Label(e.Type)</span>
                                @if (e.EndDate is null)
                                {
                                    <span class="badge badge-live"><span class="pulse" aria-hidden="true"></span>@L["Devam ediyor"]</span>
                                }
                            </div>
                            <h3>@e.Title</h3>
                            <p class="timeline-org">
                                @if (e.Url is not null)
                                {
                                    <a class="link" href="@e.Url" target="_blank" rel="noopener">@e.Organization ↗</a>
                                }
                                else
                                {
                                    <span>@e.Organization</span>
                                }
                                @if (e.Location is not null)
                                {
                                    <span class="muted"> · @e.Location</span>
                                }
                            </p>
                            @if (!string.IsNullOrWhiteSpace(e.Description))
                            {
                                <p class="timeline-desc muted">@e.Description</p>
                            }
                        </div>
                    </li>
                }
            </ol>
        }
    </div>
</section>

@if (skillGroups.Count > 0)
{
    <section class="section" id="yetenekler">
        <div class="container">
            <header class="section-head reveal">
                <p class="eyebrow">@L["Araç kutusu"]</p>
                <h2>@L["Yetenekler"]</h2>
                <p class="muted">@L["Projelerimde kullandığım teknolojiler ve araçlar."]</p>
            </header>

            <div class="skill-grid">
                @foreach (var group in skillGroups)
                {
                    <section class="card skill-card reveal">
                        <h3>@group.Key</h3>
                        <ul>
                            @foreach (var s in group)
                            {
                                <li>
                                    <a class="skill-name" asp-controller="Projects" asp-action="Index" asp-route-teknoloji="@s.Name">@s.Name</a>
                                    <span class="skill-level" style="--level: @s.Level" title="@DisplayText.Level(s.Level)">
                                        <span class="sr-only">@DisplayText.Level(s.Level)</span>
                                    </span>
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
        </div>
    </section>
}

@await Component.InvokeAsync("GitHubActivity")

@if (Model.RecentPosts.Count > 0)
{
    <section class="section section-alt" id="yazilar">
        <div class="container">
            <header class="section-head section-head-row reveal">
                <div>
                    <p class="eyebrow">Blog</p>
                    <h2>@L["Son yazılar"]</h2>
                    <p class="muted">@L["Öğrendiklerimi ve deneyimlerimi yazıya döküyorum."]</p>
                </div>
                <a class="btn btn-ghost" asp-controller="Blog" asp-action="Index">@L["Tüm yazılar →"]</a>
            </header>
            <div class="post-grid">
                @foreach (var post in Model.RecentPosts)
                {
                    <partial name="_PostCard" model="post" />
                }
            </div>
        </div>
    </section>
}
