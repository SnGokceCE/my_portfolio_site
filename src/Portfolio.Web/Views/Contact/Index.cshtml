@model ContactFormViewModel
@{
    ViewData["Title"] = "İletişim";
    ViewData["Description"] = "Staj, iş birliği ya da sadece merhaba demek için bana ulaş.";
    ViewData["NavActive"] = "contact";
    var profile = Model.Profile;
}

<section class="page-hero">
    <div class="container">
        <p class="eyebrow reveal">İletişim</p>
        <h1 class="reveal">Birlikte bir şeyler üretelim</h1>
        <p class="muted lead reveal">Staj, iş birliği, bir proje fikri ya da sadece merhaba — mesajını bekliyorum.</p>
    </div>
</section>

<section class="section section-tight">
    <div class="container contact-layout">
        <aside class="contact-info reveal">
            @if (profile.IsOpenToWork)
            {
                <span class="badge badge-live"><span class="pulse" aria-hidden="true"></span>Yeni fırsatlara açığım</span>
            }
            <ul class="contact-list">
                @if (profile.Email is not null)
                {
                    <li>
                        <span class="contact-icon" aria-hidden="true"><svg class="icon" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg></span>
                        <div><span class="muted small">E-posta</span><a class="link" href="mailto:@profile.Email">@profile.Email</a></div>
                    </li>
                }
                @if (profile.Location is not null)
                {
                    <li>
                        <span class="contact-icon" aria-hidden="true"><svg class="icon" viewBox="0 0 24 24"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></svg></span>
                        <div><span class="muted small">Konum</span><span>@profile.Location</span></div>
                    </li>
                }
                <li>
                    <span class="contact-icon" aria-hidden="true"><svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span>
                    <div><span class="muted small">Yanıt süresi</span><span>Genellikle 1–2 iş günü</span></div>
                </li>
            </ul>
            <div class="footer-links">
                @if (profile.GitHubUrl is not null)
                {
                    <a class="icon-btn" href="@profile.GitHubUrl" target="_blank" rel="noopener" aria-label="GitHub">
                        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" /></svg>
                    </a>
                }
                @if (profile.LinkedInUrl is not null)
                {
                    <a class="icon-btn" href="@profile.LinkedInUrl" target="_blank" rel="noopener" aria-label="LinkedIn">
                        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" /></svg>
                    </a>
                }
            </div>
        </aside>

        <div class="card contact-card reveal">
            @if (Model.Sent)
            {
                <div class="contact-success" role="status">
                    <div class="success-icon" aria-hidden="true">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
                    </div>
                    <h2>Mesajın ulaştı, teşekkürler!</h2>
                    <p class="muted">En kısa sürede e-posta ile dönüş yapacağım.</p>
                    <a class="btn btn-ghost" asp-action="Index">Yeni mesaj gönder</a>
                </div>
            }
            else
            {
                <form method="post" class="form" novalidate data-contact-form>
                    <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>
                    <input type="hidden" asp-for="FormToken" />

                    @* Bal küpü: ekran okuyuculardan ve klavyeden de gizli. *@
                    <div class="hp-field" aria-hidden="true">
                        <label for="Website">Web siteniz</label>
                        <input asp-for="Website" tabindex="-1" autocomplete="off" />
                    </div>

                    <div class="form-grid">
                        <div class="field">
                            <label asp-for="Input.Name">Adın</label>
                            <input asp-for="Input.Name" autocomplete="name" maxlength="100" />
                            <span asp-validation-for="Input.Name" class="field-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Input.Email">E-posta</label>
                            <input asp-for="Input.Email" type="email" autocomplete="email" maxlength="200" />
                            <span asp-validation-for="Input.Email" class="field-error"></span>
                        </div>
                    </div>
                    <div class="field">
                        <label asp-for="Input.Subject">Konu <span class="muted">(isteğe bağlı)</span></label>
                        <input asp-for="Input.Subject" maxlength="150" />
                        <span asp-validation-for="Input.Subject" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.Message">Mesaj</label>
                        <textarea asp-for="Input.Message" rows="7" maxlength="5000"></textarea>
                        <span asp-validation-for="Input.Message" class="field-error"></span>
                    </div>
                    <p class="hint">Bilgilerin yalnızca sana dönüş yapmak için kullanılır, üçüncü kişilerle paylaşılmaz.</p>
                    <button type="submit" class="btn btn-primary" data-submit>
                        <span>Mesajı gönder</span>
                        <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4z" /><path d="M22 2 11 13" /></svg>
                    </button>
                </form>
            }
        </div>
    </div>
</section>
