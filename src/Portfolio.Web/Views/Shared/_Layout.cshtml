<!DOCTYPE html>
<html lang="tr">
<head>
    <partial name="_ThemeHead" />
    <title>@(ViewData["Title"] is string title ? $"{title} · Portfolyo" : "Portfolyo")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Projelerim, deneyimlerim ve yazılarım.")" />
</head>
<body>
    <a class="skip-link" href="#main">İçeriğe geç</a>

    <header class="site-header" data-header>
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">&lt;/&gt;</span>
                <span class="brand-text">portfolyo</span>
            </a>

            <nav class="site-nav" id="site-nav" data-nav aria-label="Ana menü">
                <a href="/#hakkimda">Hakkımda</a>
                <a href="/#projeler">Projeler</a>
                <a href="/#deneyim">Deneyim</a>
                <a href="/#iletisim">İletişim</a>
            </nav>

            <div class="header-actions">
                <partial name="_ThemeToggle" />
                <button type="button" class="icon-btn nav-toggle" data-nav-toggle aria-controls="site-nav" aria-expanded="false" aria-label="Menüyü aç">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
            </div>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    @await Component.InvokeAsync("SiteFooter")

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
