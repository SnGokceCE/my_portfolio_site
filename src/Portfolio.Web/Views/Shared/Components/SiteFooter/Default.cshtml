@model SiteProfileDto

<footer class="site-footer">
    <div class="container footer-inner">
        <div>
            <p class="footer-title">@L["Birlikte bir şeyler üretelim."]</p>
            <p class="muted footer-cta">
                <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Contact" asp-action="Index">@L["Bana yaz →"]</a>
                @if (Model.Email is not null)
                {
                    <a class="link" href="mailto:@Model.Email">@Model.Email</a>
                }
            </p>
        </div>

        <div class="footer-links">
            @if (Model.GitHubUrl is not null)
            {
                <a class="icon-btn" href="@Model.GitHubUrl" target="_blank" rel="noopener" aria-label="GitHub">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" /></svg>
                </a>
            }
            @if (Model.LinkedInUrl is not null)
            {
                <a class="icon-btn" href="@Model.LinkedInUrl" target="_blank" rel="noopener" aria-label="LinkedIn">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" /></svg>
                </a>
            }
            <a class="icon-btn" href="~/blog/rss.xml" aria-label="@L["Blog RSS"]">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" /></svg>
            </a>
        </div>
    </div>
    <div class="container footer-bottom muted">
        <span>© @DateTime.Now.Year @Model.FullName</span>
        <span>@L["ASP.NET Core ile geliştirildi"]</span>
    </div>
</footer>
