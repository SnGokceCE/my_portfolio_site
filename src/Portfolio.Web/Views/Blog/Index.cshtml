@model BlogCatalog
@{
    var q = Model.Query;
    var list = Model.Posts;
    ViewData["Title"] = q.Tag is null ? L["Blog"].Value : $"#{q.Tag}";
    ViewData["Description"] = L["Öğrendiklerim, staj notlarım ve projelerimin arka planı."].Value;
    ViewData["NavActive"] = "blog";

    string BlogUrl(string? tag, int page = 1) =>
        Url.Action("Index", "Blog", new { etiket = tag, sayfa = page > 1 ? page : (int?)null })!;
}

<section class="page-hero">
    <div class="container">
        <p class="eyebrow reveal">@L["Yazılar"]</p>
        <h1 class="reveal">@L["Blog"]</h1>
        <p class="muted lead reveal">
            @if (q.Tag is not null)
            {
                <span>@Html.Raw(L.Plural(list.TotalCount, "<strong>#{0}</strong> etiketli {1} yazı.", System.Net.WebUtility.HtmlEncode(q.Tag), list.TotalCount).Value)</span>
                <a class="link" href="@BlogUrl(null)">@L["Tüm yazılar"]</a>
            }
            else
            {
                <span>@L["Öğrendiklerim, staj notlarım ve projelerimin arka planı."]</span>
            }
            <a class="link rss-link" asp-action="Rss">
                <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" /></svg>
                RSS
            </a>
        </p>
    </div>
</section>

<section class="section section-tight">
    <div class="container blog-layout">
        <div class="post-list">
            @if (list.TotalCount == 0)
            {
                <div class="empty-state reveal">
                    <div class="empty-icon" aria-hidden="true">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M4 4h16v16H4z" /><path d="M8 8h8M8 12h8M8 16h5" /></svg>
                    </div>
                    <h3>@(q.Tag is null ? L["Henüz yazı yok"] : L["Bu etikette yazı yok"])</h3>
                    <p class="muted">@L["Yakında burada yazılarımı paylaşacağım."]</p>
                </div>
            }
            else
            {
                @foreach (var post in list.Items)
                {
                    <partial name="_PostCard" model="post" />
                }

                @if (list.TotalPages > 1)
                {
                    <nav class="pager" aria-label="@L["Sayfalar"]">
                        @if (list.HasPrevious)
                        {
                            <a class="btn btn-ghost" href="@BlogUrl(q.Tag, list.Page - 1)" rel="prev">@L["← Daha yeni"]</a>
                        }
                        <span class="muted small">@L["Sayfa {0} / {1}", list.Page, list.TotalPages]</span>
                        @if (list.HasNext)
                        {
                            <a class="btn btn-ghost" href="@BlogUrl(q.Tag, list.Page + 1)" rel="next">@L["Daha eski →"]</a>
                        }
                    </nav>
                }
            }
        </div>

        @if (Model.Tags.Count > 0)
        {
            <aside class="blog-aside">
                <section class="card aside-card reveal">
                    <p class="eyebrow">@L["Etiketler"]</p>
                    <div class="tag-cloud">
                        @foreach (var tag in Model.Tags)
                        {
                            <a class="pill pill-sm @(q.Tag == tag.Value ? "active" : "")" href="@BlogUrl(q.Tag == tag.Value ? null : tag.Value)">
                                #@tag.Label <span class="pill-count">@tag.Count</span>
                            </a>
                        }
                    </div>
                </section>
            </aside>
        }
    </div>
</section>
