@model MessageDetail
@{
    ViewData["Title"] = Model.Subject ?? $"{Model.Name} mesajı";
    var replySubject = Uri.EscapeDataString("Re: " + (Model.Subject ?? "Portfolyo mesajın"));
}

<div class="message-detail">
    <a class="link small" asp-action="Index" asp-route-filter="@(Model.IsSpam ? MessageFilter.Spam : MessageFilter.Inbox)">← Mesajlara dön</a>

    <article class="card message-card">
        <header class="message-header">
            <span class="avatar avatar-lg" aria-hidden="true">@Model.Name[..1].ToUpperInvariant()</span>
            <div>
                <h2>@Model.Name</h2>
                <a class="link" href="mailto:@Model.Email">@Model.Email</a>
            </div>
            <div class="message-dates muted small">
                <span>@DisplayText.Date(Model.ReceivedAt)</span>
                @if (Model.IsSpam)
                {
                    <span class="status status-draft">Spam</span>
                }
            </div>
        </header>

        @if (Model.Subject is not null)
        {
            <h3 class="message-subject-lg">@Model.Subject</h3>
        }
        <div class="message-body">@Model.Message</div>

        <footer class="message-actions">
            <a class="btn btn-primary" href="mailto:@Model.Email?subject=@replySubject">E-postayla yanıtla</a>
            <form asp-action="MarkUnread" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-ghost">Okunmadı yap</button>
            </form>
            <form asp-action="Spam" asp-route-id="@Model.Id" method="post">
                <input type="hidden" name="isSpam" value="@(!Model.IsSpam)" />
                <button type="submit" class="btn btn-ghost">@(Model.IsSpam ? "Spam değil" : "Spam olarak işaretle")</button>
            </form>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="@Model.Name adlı kişinin mesajı kalıcı olarak silinecek.">
                <button type="submit" class="btn btn-danger-ghost">Sil</button>
            </form>
        </footer>
    </article>
</div>
