@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <partial name="_ThemeHead" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(ViewData["Title"] ?? "Panel") · Yönetim</title>
</head>
<body class="admin">
    <div class="admin-shell">
        <aside class="admin-sidebar" id="admin-nav" data-nav>
            <a class="brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">&lt;/&gt;</span>
                <span class="brand-text">yönetim</span>
            </a>

            <nav class="admin-nav" aria-label="Yönetim menüsü">
                <p class="admin-nav-label">Genel</p>
                <a class="@Active("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></svg>
                    Pano
                </a>

                <p class="admin-nav-label">İçerik</p>
                <span class="admin-nav-soon">Projeler <em>yakında</em></span>
                <span class="admin-nav-soon">Deneyimler <em>yakında</em></span>
                <span class="admin-nav-soon">Yetenekler <em>yakında</em></span>
                <span class="admin-nav-soon">Blog <em>yakında</em></span>
            </nav>

            <div class="admin-sidebar-foot">
                <a class="btn btn-ghost btn-sm" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">Siteyi görüntüle ↗</a>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <button type="button" class="icon-btn nav-toggle" data-nav-toggle aria-controls="admin-nav" aria-expanded="false" aria-label="Menüyü aç">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
                <h1 class="admin-title">@ViewData["Title"]</h1>
                <div class="header-actions">
                    <span class="muted admin-user">@User.Identity?.Name</span>
                    <partial name="_ThemeToggle" />
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-ghost btn-sm">Çıkış</button>
                    </form>
                </div>
            </header>

            <main id="main" class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
