@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <partial name="_ThemeHead" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <title>@(ViewData["Title"] ?? "Panel") · Yönetim</title>
</head>
<body class="admin">
    <div class="admin-shell">
        <aside class="admin-sidebar" id="admin-nav" data-nav>
            <a class="brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">&lt;/&gt;</span>
                <span class="brand-text">yönetim</span>
            </a>

            <nav class="admin-nav" aria-label="Yönetim menüsü">
                <p class="admin-nav-label">Genel</p>
                <a class="@Active("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></svg>
                    Pano
                </a>
                <a class="@Active("Analytics")" asp-area="Admin" asp-controller="Analytics" asp-action="Index">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18" /><path d="m7 15 4-4 3 3 5-6" /></svg>
                    İstatistikler
                </a>
                <a class="@Active("Profile")" asp-area="Admin" asp-controller="Profile" asp-action="Index">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
                    Profil
                </a>

                <p class="admin-nav-label">İçerik</p>
                <a class="@Active("Projects")" asp-area="Admin" asp-controller="Projects" asp-action="Index">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
                    Projeler
                </a>
                <a class="@Active("Experiences")" asp-area="Admin" asp-controller="Experiences" asp-action="Index">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18" /></svg>
                    Deneyimler
                </a>
                <a class="@Active("Skills")" asp-area="Admin" asp-controller="Skills" asp-action="Index">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7z" /></svg>
                    Yetenekler
                </a>
                <a class="@Active("Categories")" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z" /><circle cx="7.5" cy="7.5" r="1.5" /></svg>
                    Kategoriler
                </a>
                <a class="@Active("Posts")" asp-area="Admin" asp-controller="Posts" asp-action="Index">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4z" /><path d="M8 8h8M8 12h8M8 16h5" /></svg>
                    Blog
                </a>

                <p class="admin-nav-label">Gelen kutusu</p>
                <a class="@Active("Messages")" asp-area="Admin" asp-controller="Messages" asp-action="Index">
                    <svg class="icon icon-sm" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                    Mesajlar
                    <span class="nav-badge">@await Component.InvokeAsync("UnreadMessages")</span>
                </a>
            </nav>

            <div class="admin-sidebar-foot">
                <a class="btn btn-ghost btn-sm" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">Siteyi görüntüle ↗</a>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <button type="button" class="icon-btn nav-toggle" data-nav-toggle aria-controls="admin-nav" aria-expanded="false" aria-label="Menüyü aç">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
                <h1 class="admin-title">@ViewData["Title"]</h1>
                <div class="header-actions">
                    <span class="muted admin-user">@User.Identity?.Name</span>
                    <partial name="_ThemeToggle" />
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-ghost btn-sm">Çıkış</button>
                    </form>
                </div>
            </header>

            <main id="main" class="admin-content">
                <partial name="_Flash" />
                @RenderBody()
            </main>
        </div>
    </div>

    <dialog class="confirm-dialog" data-confirm-dialog aria-labelledby="confirm-title">
        <form method="dialog">
            <div class="confirm-icon" aria-hidden="true">
                <svg class="icon" viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /></svg>
            </div>
            <h2 id="confirm-title">Emin misin?</h2>
            <p class="muted" data-confirm-message></p>
            <div class="confirm-actions">
                <button value="cancel" class="btn btn-ghost">Vazgeç</button>
                <button value="ok" class="btn btn-danger" data-confirm-ok>Evet, sil</button>
            </div>
        </form>
    </dialog>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
